DATABASE_URL=postgres://vasanam:vasanam@localhost:5434/vasanam
APP_URL=http://localhost:3000
STORAGE_DIR=./storage

# AI — default provider/model; can be switched live from /admin
AI_PROVIDER=gemini            # gemini | openai | groq | custom
AI_MODEL=gemini-2.5-flash     # gemini model, or the translation LLM for openai/groq/custom
AI_STT_MODEL=                 # openai: whisper-1 · groq: whisper-large-v3-turbo
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=                  # custom: any OpenAI-compatible endpoint (OpenRouter, Together, Ollama...)
AI_API_KEY=

# Razorpay (create the 3 plans in the Razorpay dashboard, paste their ids)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STUDIO=

# First account signing up with this email becomes admin
ADMIN_EMAIL=
FFMPEG_DIR=                   # only if ffmpeg/ffprobe are not on PATH
